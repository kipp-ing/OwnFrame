      }
    },
    "Thank you" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke"
          }
        }
      }
    },
    "That genuinely helps, and it means a lot. Nothing about the app changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hilft wirklich und bedeutet viel. An der App hat sich nichts geändert."
          }
        }
      }
    },
    "The App Store is unreachable" : {
      "extractionState" : "manual",
