    },
    "Paste an Immich share link — no account or API key needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Immich-Freigabelink einfügen — ohne Konto oder API-Schlüssel."
          }
        }
      }
    },
    "Paste the Immich share link someone sent you. You'll only be asked for a password if the link needs one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den Immich-Freigabelink ein, den dir jemand geschickt hat. Nach einem Passwort wirst du nur gefragt, wenn der Link eines benötigt."
          }
        }
      }
    },
    "Photos drift and scale slowly instead of sitting still." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos driften und zoomen langsam, statt stillzustehen."
          }
        }
      }
    },
    "Pick the album to play. You can change it later in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Album, das abgespielt werden soll. Du kannst es später in den Einstellungen ändern."
