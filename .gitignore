# Swift Package Manager
.build/
# Ignore checked-out SPM dependency folders, but track our own local module(s).
Packages/*
!Packages/ImmichClient/
!Packages/OnboardingKit/
!Packages/SlideshowKit/
!Packages/PowerKit/
!Packages/HAControlKit/
!Packages/BrokerSetupKit/
!Packages/ThemeKit/
!Packages/PhotoSourceKit/
!Packages/PhotoLibraryKit/
Package.pins
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
# Track the workspace's SPM pin file (reproducible dependency versions) and the
# workspace data, but nothing else inside project.xcworkspace (user state).
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
!*.xcworkspace/contents.xcworkspacedata

